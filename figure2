CREATE OR REPLACE MODEL `foreign-phd.new.fig2_team_model`
OPTIONS(
  model_type = 'logistic_reg',
  input_label_cols = ['is_top1'],
  auto_class_weights = TRUE,
  l2_reg = 1.0
) AS
SELECT
  is_top1,
  foreign_flag,
  publication_year,
  umbrella_domain,
  InstitutionId,
  research_intensity_label,
  control_label,
  career_stage,
  team_type,
  team_size_bucket
FROM `foreign-phd.new.figure2_model_source`
;

-- Build a compact model table for Figure 2 Panel D
-- One row per covariate combination, with counts for weighted GLM

CREATE OR REPLACE TABLE `foreign-phd.new.figure2_model_agg` AS
WITH src AS (
  SELECT
    CAST(publication_year AS STRING) AS publication_year,
    CAST(foreign AS INT64) AS foreign_flag,
    umbrella_domain AS domain,
    CAST(InstitutionId AS STRING) AS InstitutionId,
    CAST(research_intensity_label AS STRING) AS research_intensity_label,
    CAST(control_label AS STRING) AS control_label,
    CAST(career_stage AS STRING) AS career_stage,
    CAST(team_type AS STRING) AS team_type,
    CAST(team_size AS INT64) AS team_size,
    CAST(is_top1 AS INT64) AS is_top1
  FROM `foreign-phd.new.figure2_decomp_source`
  WHERE is_top1 IS NOT NULL
)

SELECT
  publication_year,
  foreign_flag,
  domain,
  InstitutionId,
  research_intensity_label,
  control_label,
  career_stage,
  team_type,
  CASE
    WHEN team_size = 1 THEN '1'
    WHEN team_size = 2 THEN '2'
    WHEN team_size BETWEEN 3 AND 5 THEN '3-5'
    WHEN team_size BETWEEN 6 AND 10 THEN '6-10'
    ELSE '11+'
  END AS team_size_bucket,
  COUNT(*) AS n_rows,
  SUM(is_top1) AS top1_rows
FROM src
GROUP BY
  publication_year,
  foreign_flag,
  domain,
  InstitutionId,
  research_intensity_label,
  control_label,
  career_stage,
  team_type,
  team_size_bucket
;
